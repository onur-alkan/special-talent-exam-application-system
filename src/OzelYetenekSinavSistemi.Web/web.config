<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS requestFiltering: multipart fotoğraf yükleme istekleri en fazla 3 MB.
  (PhotoUploadLimits.MaxMultipartRequestBytes = 3145728)
  AspNetCoreModule transform'ları yayın sırasında aspNetCore öğesini ekler/günceller.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="3145728" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
