@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Parola Sıfırlama";
    Layout = "_AuthLayout";
}

<h3>Yeni Parola Belirle</h3>

<form asp-action="ResetPassword" method="post" class="m-t">
    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
    <input type="hidden" asp-for="Token" />
    <div class="form-group">
        <label asp-for="NewPassword" class="sr-only"></label>
        <input asp-for="NewPassword" class="form-control" placeholder="Yeni Parola" />
        <span asp-validation-for="NewPassword" class="text-danger small"></span>
    </div>
    <div class="form-group">
        <label asp-for="ConfirmPassword" class="sr-only"></label>
        <input asp-for="ConfirmPassword" class="form-control" placeholder="Yeni Parola (Tekrar)" />
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-primary block full-width m-b">Parolayı Güncelle</button>
    <a class="btn btn-sm btn-white btn-block" asp-action="Login">Girişe Dön</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
