@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Parolamı Unuttum";
    ViewData["AuthBodyClass"] = "site-forgot-page";
    Layout = "_AuthLayout";
}

<header class="site-forgot-brand">
    <h1 class="site-forgot-title">Parola Sıfırlama</h1>
    <p class="site-forgot-lead">
        Hesabınıza ait e-posta adresinizi veya T.C. Kimlik Numaranızı giriniz.
        Bilgileriniz sistemde kayıtlıysa sıfırlama bağlantısı e-posta adresinize gönderilecektir.
    </p>
</header>

<form asp-action="ForgotPassword"
      method="post"
      class="site-forgot-form">
    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

    <div class="form-group">
        <label asp-for="TcNoOrEmail" class="sr-only">E-posta adresi veya T.C. kimlik numarası</label>
        <input asp-for="TcNoOrEmail"
               class="form-control site-forgot-input"
               placeholder="E-posta adresi veya T.C. kimlik numarası"
               autocomplete="username"
               maxlength="254"
               data-oys-login-identifier
               aria-describedby="forgot-identifier-help" />
        <span asp-validation-for="TcNoOrEmail" class="text-danger small"></span>
        <p id="forgot-identifier-help" class="site-forgot-help text-muted small">
            <i class="fa fa-info-circle" aria-hidden="true"></i>
            Yabancı uyruklu adaylar kayıt sırasında kullandıkları e-posta adresini girmelidir.
        </p>
    </div>

    <button type="submit" class="btn btn-primary block full-width site-forgot-submit">
        Sıfırlama Bağlantısı Gönder
    </button>
    <a class="btn btn-white block full-width site-forgot-back"
       asp-action="Login">Girişe Dön</a>
</form>

<p class="site-forgot-footnote">
    &copy; @DateTime.Now.Year Özel Yetenek Sınavları Başvuru Sistemi
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
