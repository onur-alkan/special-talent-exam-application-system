@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Parola Değiştir";
    Layout = "_AuthLayout";
}

<h3>Parola Değiştir</h3>
<p>Güvenliğiniz için güçlü bir parola belirleyiniz.</p>

<form asp-action="ChangePassword" method="post" class="m-t">
    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
    <div class="form-group">
        <label asp-for="CurrentPassword" class="sr-only"></label>
        <input asp-for="CurrentPassword" class="form-control" placeholder="Mevcut Parola" />
        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
    </div>
    <div class="form-group">
        <label asp-for="NewPassword" class="sr-only"></label>
        <input asp-for="NewPassword" class="form-control" placeholder="Yeni Parola" />
        <span asp-validation-for="NewPassword" class="text-danger small"></span>
    </div>
    <div class="form-group">
        <label asp-for="ConfirmPassword" class="sr-only"></label>
        <input asp-for="ConfirmPassword" class="form-control" placeholder="Yeni Parola (Tekrar)" />
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-primary block full-width m-b">Parolayı Değiştir</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
