@model OzelYetenekSinavSistemi.Application.ViewModels.SystemSettings.SystemSettingIndexViewModel

<div class="card">
    <div class="card-header"><h1 class="h5 mb-0">Sistem Ayarları</h1></div>
    <div class="card-body">
        @if (Model.Settings.Count == 0)
        {
            <p class="text-muted">Tanımlı sistem ayarı bulunmuyor.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th scope="col">Anahtar</th><th scope="col">Değer</th><th scope="col">Açıklama</th><th scope="col"></th></tr></thead>
                    <tbody>
                        @foreach (var setting in Model.Settings)
                        {
                            <tr>
                                <td><code>@setting.SettingKey</code></td>
                                <td>
                                    <partial name="_SystemSettingRow" model="setting" />
                                </td>
                                <td>@setting.Description</td>
                                <td class="small text-muted">@(setting.UpdatedDate?.ToString("dd.MM.yyyy HH:mm"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <hr />
        <p class="text-muted small mb-0">Yalnızca tanımlı sistem ayarları güncellenebilir. Yeni anahtar oluşturma desteklenmez.</p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
