@model IReadOnlyList<OzelYetenekSinavSistemi.Application.ViewModels.UserManagement.StaffUserListItemViewModel>
@{
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 50;
}

<div class="card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h5 class="mb-0">Personel Yönetimi</h5>
        <div>
            <a asp-action="Create" class="btn btn-primary btn-sm">Yeni Personel</a>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Ad Soyad</th>
                        <th>T.C.</th>
                        <th>E-posta</th>
                        <th>Rol</th>
                        <th>Durum</th>
                        <th>Oluşturulma</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.FullName</td>
                        <td>@u.MaskedTcNo</td>
                        <td>@u.MaskedEmail</td>
                        <td>@u.RoleName</td>
                        <td>@(u.IsActive ? "Aktif" : "Pasif")</td>
                        <td>@u.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-secondary btn-sm">Düzenle</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="mt-3">
            @if (page > 1)
            {
                <a class="btn btn-secondary btn-sm" asp-action="Index" asp-route-page="@(page - 1)">Önceki</a>
            }
            @if (Model.Count >= pageSize)
            {
                <a class="btn btn-secondary btn-sm" asp-action="Index" asp-route-page="@(page + 1)">Sonraki</a>
            }
        </div>
    </div>
</div>
