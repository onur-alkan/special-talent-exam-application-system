@model IReadOnlyList<OzelYetenekSinavSistemi.Domain.Entities.ExamPeriod>

<div class="card">
    <div class="card-header"><h5 class="mb-0">Aday Başvuruları - Sınav Dönemi Seçin</h5></div>
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <p class="text-muted">Görüntüleyebileceğiniz sınav dönemi yok.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead><tr><th>Sınav Dönemi</th><th>Tarih</th><th>Durum</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var e in Model)
                        {
                            <tr>
                                <td>@e.Title</td>
                                <td>@e.StartDate.ToString("dd.MM.yyyy") - @e.EndDate.ToString("dd.MM.yyyy")</td>
                                <td>@(e.IsClosed ? "Kapalı" : e.IsActive ? "Aktif" : "Pasif")</td>
                                <td class="text-end">
                                    <a asp-action="List" asp-route-examPeriodId="@e.Id" class="btn btn-sm btn-primary">Adayları Gör</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
