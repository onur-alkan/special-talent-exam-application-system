@model IReadOnlyList<OzelYetenekSinavSistemi.Application.DTOs.Applications.CandidateApplicationDetail>
@using OzelYetenekSinavSistemi.Domain.Entities
@{
    var exam = ViewBag.ExamPeriod as ExamPeriod;
}

<div class="card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h5 class="mb-0">Adaylar - @exam?.Title</h5>
        <div>
            <a asp-controller="ExamResult" asp-action="List" asp-route-examPeriodId="@exam?.Id" class="btn btn-secondary btn-sm">Sonuç Değerlendirme</a>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover align-middle dataTable js-datatable"
                   data-page-length="25"
                   data-order-col="0"
                   data-order-dir="asc"
                   data-oys-buttons="copy,excel,pdf,print"
                   data-export-title="Adaylar">
                <thead>
                    <tr>
                        <th>Aday No</th>
                        <th>Ad Soyad</th>
                        <th>E-posta</th>
                        <th>Telefon</th>
                        <th>Tercihler</th>
                        <th>Başvuru Tarihi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.CandidateNo</td>
                            <td>@c.FullName</td>
                            <td>@c.Email</td>
                            <td>@c.Phone</td>
                            <td>@string.Join(", ", c.Preferences)</td>
                            <td>@c.RegistrationDate.ToString("dd.MM.yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* DataTables: site.js .js-datatable *@
