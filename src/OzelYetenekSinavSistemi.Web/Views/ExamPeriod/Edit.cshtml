@model OzelYetenekSinavSistemi.Application.ViewModels.ExamPeriods.ExamPeriodFormViewModel

<div class="card">
    <div class="card-header"><h5 class="mb-0">Sınav Dönemini Düzenle</h5></div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <partial name="_ExamPeriodFields" model="Model" />
            <button type="submit" class="btn btn-primary">Güncelle</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Vazgeç</a>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
