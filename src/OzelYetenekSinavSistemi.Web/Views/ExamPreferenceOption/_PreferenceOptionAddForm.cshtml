@model OzelYetenekSinavSistemi.Application.ViewModels.ExamPeriods.PreferenceOptionFormViewModel
@*
  Add aksiyonu PreferenceOptionFormViewModel bekler; alan adları prefix'siz olmalı.
*@
<form asp-action="Add" method="post" class="form-horizontal">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="ExamPeriodId" />

    <div class="form-group row">
        <label asp-for="DisplayOrder" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-2">
            <input asp-for="DisplayOrder" class="form-control" type="number" min="1" max="999" />
            <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="PreferenceName" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-8">
            <input asp-for="PreferenceName" class="form-control" autocomplete="off" />
            <span asp-validation-for="PreferenceName" class="text-danger small"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="IsActive" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-8">
            <div class="checkbox-inline m-t-xs">
                <input asp-for="IsActive" type="checkbox" />
                <label asp-for="IsActive">Aktif</label>
            </div>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-sm-10 offset-sm-2 text-right">
            <button type="submit" class="btn btn-primary">Yeni Kayıt Ekle</button>
            <a asp-action="Index" class="btn btn-warning">Vazgeç</a>
        </div>
    </div>
</form>
