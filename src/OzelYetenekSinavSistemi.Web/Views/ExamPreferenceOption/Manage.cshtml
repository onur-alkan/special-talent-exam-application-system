@model OzelYetenekSinavSistemi.Application.ViewModels.ExamPeriods.PreferenceOptionManagePageViewModel
@{
    var dataUrl = Url.Action("Data", "ExamPreferenceOption", new { examPeriodId = Model.ExamPeriodId });
    var editUrlTemplate = Url.Action("Edit", "ExamPreferenceOption", new { id = "__ID__" });
    var deleteUrl = Url.Action("Delete", "ExamPreferenceOption");
}

<div class="card mb-3">
    <div class="card-header">
        <h5 class="mb-0">Yeni Tercih Seçeneği Ekle</h5>
    </div>
    <div class="card-body">
        <partial name="_PreferenceOptionAddForm" model="Model.AddForm" />
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Tüm Tercih Seçenekleri</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover align-middle dataTable js-datatable"
                   id="preference-options-table"
                   data-oys-server-side="true"
                   data-ajax-url="@dataUrl"
                   data-edit-url-template="@editUrlTemplate"
                   data-delete-url="@deleteUrl"
                   data-page-length="10"
                   data-order-col="0"
                   data-order-dir="asc"
                   data-oys-length-menu="10,25,50,100"
                   data-search-placeholder="Tabloda ara"
                   data-search-delay="400">
                <thead>
                    <tr>
                        <th>Sıra</th>
                        <th>Tercih Adı</th>
                        <th>Durum</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
