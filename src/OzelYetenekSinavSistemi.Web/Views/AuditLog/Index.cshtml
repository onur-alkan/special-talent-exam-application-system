@model IReadOnlyList<OzelYetenekSinavSistemi.Domain.Entities.AuditLog>
@{
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 50;
}

<div class="card">
    <div class="card-header"><h5 class="mb-0">Denetim Kayıtları (Sayfa @(page), @Model.Count kayıt)</h5></div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover align-middle dataTable js-datatable"
                   data-page-length="50"
                   data-order-col="0"
                   data-order-dir="desc"
                   data-paging="false">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Olay</th>
                        <th>Açıklama</th>
                        <th>Kullanıcı</th>
                        <th>IP</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td data-order="@log.CreatedDate.Ticks">@log.CreatedDate.ToString("dd.MM.yyyy HH:mm:ss")</td>
                            <td><span class="badge text-bg-primary">@log.EventType</span></td>
                            <td>@log.Description</td>
                            <td>@(log.UserId?.ToString() ?? "-")</td>
                            <td>@log.IpAddress</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mt-3">
            @if (page > 1)
            {
                <a class="btn btn-secondary btn-sm" asp-action="Index" asp-route-page="@(page - 1)" asp-route-pageSize="@pageSize">Önceki</a>
            }
            @if (Model.Count >= pageSize)
            {
                <a class="btn btn-secondary btn-sm" asp-action="Index" asp-route-page="@(page + 1)" asp-route-pageSize="@pageSize">Sonraki</a>
            }
        </div>
    </div>
</div>

@* DataTables: site.js .js-datatable *@
