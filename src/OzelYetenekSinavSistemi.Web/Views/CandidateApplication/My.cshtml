@model IReadOnlyList<OzelYetenekSinavSistemi.Application.DTOs.Applications.CandidateApplicationDetail>
@using OzelYetenekSinavSistemi.Domain.Enums
@{
    Layout = "_CandidateLayout";
    static string StatusText(ApplicationStatus s) => s switch
    {
        ApplicationStatus.Submitted => "Alındı",
        ApplicationStatus.Updated => "Güncellendi",
        ApplicationStatus.Cancelled => "İptal",
        ApplicationStatus.Evaluated => "Değerlendirildi",
        _ => s.ToString()
    };
}

<div class="card">
    <div class="card-header"><h1 class="h5 mb-0">Başvurularım</h1></div>
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <p class="text-muted mb-0">Henüz bir başvurunuz bulunmuyor.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Sınav / Başvuru</th>
                            <th>Aday No</th>
                            <th>Durum</th>
                            <th>Başvuru Tarihi</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model)
                        {
                            <tr>
                                <td>@app.ExamTitle</td>
                                <td><span class="badge text-bg-primary">@app.CandidateNo</span></td>
                                <td>@StatusText(app.Status)</td>
                                <td>@app.RegistrationDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-end">
                                    <a asp-action="Detail" asp-route-id="@app.ApplicationId" class="btn btn-sm btn-outline-secondary">Detay</a>
                                    @if (app.CanEdit)
                                    {
                                        <a asp-action="Edit" asp-route-id="@app.ApplicationId" class="btn btn-sm btn-info">Güncelle</a>
                                    }
                                    else
                                    {
                                        <span class="btn btn-sm btn-secondary disabled" title="Başvuru güncelleme süresi dışında">Güncelleme kapalı</span>
                                    }
                                    @if (app.CanAccessExamEntranceDocument)
                                    {
                                        <a asp-controller="ExamDocument" asp-action="View" asp-route-id="@app.ApplicationId" class="btn btn-sm btn-primary" target="_blank">Giriş Belgesi</a>
                                    }
                                    else
                                    {
                                        <span class="btn btn-sm btn-secondary disabled"
                                              role="button"
                                              aria-disabled="true"
                                              tabindex="0"
                                              title="Sınava giriş belgesi, başvuru süresi sona erdikten sonra erişime açılacaktır. Erişim tarihi: @app.ExamPeriodEndDate.ToString("dd.MM.yyyy HH:mm")">
                                            Giriş Belgesi
                                        </span>
                                    }
                                    @if (app.AttendanceStatus.HasValue)
                                    {
                                        <a asp-controller="ExamDocument" asp-action="Result" asp-route-id="@app.ApplicationId" class="btn btn-sm btn-success" target="_blank">Sınav Sonuç Belgesi</a>
                                    }
                                    else
                                    {
                                        <span class="btn btn-sm btn-secondary disabled" title="Sonuç henüz açıklanmadı">Sonuç henüz açıklanmadı</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
