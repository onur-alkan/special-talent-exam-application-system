@model OzelYetenekSinavSistemi.Application.DTOs.Applications.CandidateApplicationDetail
@using OzelYetenekSinavSistemi.Domain.Enums
@using OzelYetenekSinavSistemi.Domain.Extensions
@{
    Layout = "_CandidateLayout";
}

<div class="card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h1 class="h5 mb-0">@Model.ExamTitle</h1>
        <div class="d-flex flex-wrap gap-2">
            @if (Model.CanAccessExamEntranceDocument)
            {
                <a asp-controller="ExamDocument" asp-action="View" asp-route-id="@Model.ApplicationId" target="_blank" class="btn btn-primary btn-sm">
                    Sınava Giriş Belgesi
                </a>
            }
            else
            {
                <span class="btn btn-secondary btn-sm disabled"
                      role="button"
                      aria-disabled="true"
                      tabindex="0"
                      title="Sınava giriş belgesi, başvuru süresi sona erdikten sonra erişime açılacaktır. Erişim tarihi: @Model.ExamPeriodEndDate.ToString("dd.MM.yyyy HH:mm")">
                    Sınava Giriş Belgesi
                </span>
            }
            @if (Model.AttendanceStatus.HasValue)
            {
                <a asp-controller="ExamDocument" asp-action="Result" asp-route-id="@Model.ApplicationId" target="_blank" class="btn btn-success btn-sm">
                    Sınav Sonuç Belgesi
                </a>
            }
            else
            {
                <span class="btn btn-secondary btn-sm disabled" title="Sonuç henüz açıklanmadı">Sonuç henüz açıklanmadı</span>
            }
        </div>
    </div>
    <div class="card-body">
        @if (!Model.CanAccessExamEntranceDocument)
        {
            <p class="text-muted mb-3" role="status">
                Sınava giriş belgesi, başvuru süresi sona erdikten sonra erişime açılacaktır.
                <br />
                Erişim tarihi: @Model.ExamPeriodEndDate.ToString("dd.MM.yyyy HH:mm")
            </p>
        }
        <dl class="row mb-0">
            <dt class="col-sm-3">Aday Numarası</dt>
            <dd class="col-sm-9"><p class="h2 text-primary mb-0">@Model.CandidateNo</p></dd>

            <dt class="col-sm-3">Ad Soyad</dt>
            <dd class="col-sm-9">@Model.FullName</dd>

            <dt class="col-sm-3">Başvuru Tarihi</dt>
            <dd class="col-sm-9">@Model.RegistrationDate.ToString("dd.MM.yyyy HH:mm")</dd>

            <dt class="col-sm-3">Doğrulama Kodu</dt>
            <dd class="col-sm-9">
                @if (Model.CanAccessExamEntranceDocument)
                {
                    <code>@Model.VerificationCode</code>
                }
                else
                {
                    <span class="text-muted" role="status">Belge doğrulama bilgileri, başvuru süresi sona erdikten sonra görüntülenecektir.</span>
                }
            </dd>

            <dt class="col-sm-3">Tercihleriniz</dt>
            <dd class="col-sm-9">
                <ol class="mb-0">
                    @foreach (var pref in Model.Preferences)
                    {
                        <li>@pref</li>
                    }
                </ol>
            </dd>
        </dl>

        @if (Model.AttendanceStatus.HasValue)
        {
            <hr />
            <h2 class="h4">Sınav Sonucu</h2>
            <dl class="row mb-0">
                <dt class="col-sm-3">Sınava Girme Durumu</dt>
                <dd class="col-sm-9">@Model.AttendanceStatus.ToDisplayText()</dd>
                @if (Model.ExamScore.HasValue)
                {
                    <dt class="col-sm-3">Puan</dt>
                    <dd class="col-sm-9">@Model.ExamScore</dd>
                }
                @if (Model.IsDescriptionVisibleToCandidate && !string.IsNullOrWhiteSpace(Model.AdminDescription))
                {
                    <dt class="col-sm-3">Açıklama</dt>
                    <dd class="col-sm-9">@Model.AdminDescription</dd>
                }
            </dl>
        }

        <div class="mt-3 d-flex flex-wrap gap-2">
            <a asp-action="My" class="btn btn-outline-secondary">Başvurularıma Dön</a>
            @if (Model.CanEdit)
            {
                <a asp-action="Edit" asp-route-id="@Model.ApplicationId" class="btn btn-info">Tercihleri Güncelle</a>
            }
            else
            {
                <span class="btn btn-secondary disabled" title="Başvuru güncelleme süresi dışında">Güncelleme kapalı</span>
            }
        </div>
    </div>
</div>
