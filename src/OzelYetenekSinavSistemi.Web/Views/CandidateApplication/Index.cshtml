@model IReadOnlyList<OzelYetenekSinavSistemi.Domain.Entities.ExamPeriod>
@{
    Layout = "_CandidateLayout";
}

<div class="card">
    <div class="card-header"><h1 class="h5 mb-0">Aktif Sınav Dönemleri</h1></div>
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <p class="text-muted mb-0">Şu anda başvuruya açık bir sınav dönemi bulunmuyor.</p>
        }
        else
        {
            <div class="row g-3">
                @foreach (var exam in Model)
                {
                    <div class="col-md-6">
                        <div class="card h-100 border">
                            <div class="card-body">
                                <h2 class="h4">@exam.Title</h2>
                                <p class="text-muted">@exam.Description</p>
                                <ul class="list-unstyled small">
                                    <li>Başlangıç: @exam.StartDate.ToString("dd.MM.yyyy HH:mm")</li>
                                    <li>Bitiş: @exam.EndDate.ToString("dd.MM.yyyy HH:mm")</li>
                                    <li>Maksimum tercih: @exam.MaxPreferences</li>
                                </ul>
                                <a asp-action="Apply" asp-route-id="@exam.Id" class="btn btn-primary btn-sm">Başvuru Yap</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
