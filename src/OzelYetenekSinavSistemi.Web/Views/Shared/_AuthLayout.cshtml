<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <partial name="_BrowserTabHead" />

    <link href="~/vendor/bootstrap/5.3.8/css/bootstrap.min.css" rel="stylesheet" />
    <partial name="_AuthVendorStyles" />
    <link href="~/css/site-security.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/public-edition.css" rel="stylesheet" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="site-auth-page pe-auth @(ViewData["AuthBodyClass"] as string)">
    <main class="container py-4 pe-auth-main">
        <div class="site-auth-box mx-auto text-center">
            @if (ViewData["HideOfficialAuthLogo"] as bool? != true)
            {
                <partial name="_OfficialUniversityLogo" model='"site-auth-official-logo"' />
            }
            <p class="pe-auth-product-name mb-3">Özel Yetenek Sınavları Başvuru Sistemi</p>
            @RenderBody()
        </div>
    </main>

    <script src="~/vendor/jquery/3.7.1/js/jquery.min.js"></script>
    <script src="~/vendor/bootstrap/5.3.8/js/bootstrap.bundle.min.js"></script>
    <partial name="_AuthVendorScripts" />
    <script src="~/js/input-text-validation.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_Notifications" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
