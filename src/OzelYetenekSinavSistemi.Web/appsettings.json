    "SendTimeoutSeconds": 30
  },
  "Seed": {
    "SuperAdminTcNo": "11111111110",
    "SuperAdminEmail": "admin@example.com",
    "SuperAdminFirstName": "Sistem",
    "SuperAdminLastName": "Yöneticisi",
    "SeedTestData": false
  },
  "DataRetention": {
    "SerilogSqlDays": 90,
    "AuditLogDays": 365,
