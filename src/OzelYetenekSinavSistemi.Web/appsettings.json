{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "PublicUrl": {
    "BaseUrl": "https://localhost:7102"
  },
  "ReverseProxy": {
    "Enabled": false,
    "ForwardLimit": 1,
    "RequireHeaderSymmetry": true,
    "KnownProxies": [],
