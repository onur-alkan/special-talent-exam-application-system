    "ProtectToLocalMachine": false
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "PhotoUpload": {
    "MaxBytes": 2097152
  },
  "Email": {
    "DeliveryMode": "Disabled",
